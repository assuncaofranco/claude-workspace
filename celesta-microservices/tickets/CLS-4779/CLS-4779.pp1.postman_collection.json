                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('BO_access_token', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Find the deposit in the transaction report ({{manualDepositUid}})",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{BO_access_token}}"
              }
            ],
            "url": "{{BO_baseUrl}}/api/gateway/domain/{{domainId}}/finance/transaction_reports",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"filter\": {\n    \"internalId\": \"{{manualDepositUid}}\"\n  },\n  \"limit\": 1,\n  \"offset\": 0\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 300) console.log(pm.request.method + ' ' + pm.request.url + ' -> ' + pm.response.code + ' ' + pm.response.text().slice(0, 800));",
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const row = (pm.response.json() || [])[0];",
                  "",
                  "const n = Number(pm.collectionVariables.get('poll_manualDepositId') || 0) + 1;",
                  "pm.collectionVariables.set('poll_manualDepositId', n);",
                  "if (row && row.status === 'success') {",
                  "    pm.collectionVariables.set('poll_manualDepositId', 0);",
                  "    console.log('deposit row: ' + JSON.stringify(row));",
                  "    pm.collectionVariables.set('manualDepositId', row.id);",
                  "    pm.test('the report shows a successful Paytech visa sale (what the refund modal reads)', () => {",
                  "        pm.expect(row.provider).to.equal('paytech');",
                  "        pm.expect(row.paymentMethod).to.equal('visa');",
                  "        pm.expect(row.type).to.equal('sale');",
                  "    });",
                  "} else if (n < Number(pm.collectionVariables.get('pollMax'))) {",
                  "    setTimeout(() => {}, Number(pm.collectionVariables.get('pollMs')));",
                  "    postman.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "    pm.collectionVariables.set('poll_manualDepositId', 0);",
                  "    pm.test('deposit reached success in the report', () => pm.expect.fail('last row: ' + JSON.stringify(row)));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Manual refund",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{BO_access_token}}"
              }
            ],
            "url": "{{BO_baseUrl}}/api/gateway/domain/{{domainId}}/payment/refund/{{manualDepositId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": \"{{manualDepositAmount}}\",\n  \"refundType\": \"manual\",\n  \"message\": \"CLS-4779 preprod check\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 300) console.log(pm.request.method + ' ' + pm.request.url + ' -> ' + pm.response.code + ' ' + pm.response.text().slice(0, 800));",
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "",
                  "const r = pm.response.json();",
                  "console.log('refund3Id answer at ' + new Date().toISOString() + ': ' + JSON.stringify(r).slice(0, 600));",
                  "pm.test('a refund transaction came back', () => {",
                  "    pm.expect(r.type).to.equal('refund');",
                  "    pm.expect(['initiated', 'pending', 'success']).to.include(r.status);",
                  "});",
                  "pm.collectionVariables.set('refund3Id', r.id);",
                  "pm.collectionVariables.set('refund3Id_at', Date.now());"
                ]
              }
            }
          ]
        },
        {
          "name": "Refund status until final ({{refund3Id}})",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{BO_access_token}}"
              }
            ],
            "url": "{{BO_baseUrl}}/api/gateway/domain/{{domainId}}/payment/player/{{playerId}}/transaction-history/{{refund3Id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 300) console.log(pm.request.method + ' ' + pm.request.url + ' -> ' + pm.response.code + ' ' + pm.response.text().slice(0, 800));",
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const st = (pm.response.json() || []).filter(h => h.type === 'status');",
                  "const last = st.length ? st[st.length - 1].valueAfter : null;",
                  "",
                  "const n = Number(pm.collectionVariables.get('poll_refund3Id') || 0) + 1;",
                  "pm.collectionVariables.set('poll_refund3Id', n);",
                  "if (['success', 'failure', 'timeout', 'fraud'].includes(last)) {",
                  "    pm.collectionVariables.set('poll_refund3Id', 0);",
                  "    const secs = Math.round((Date.now() - Number(pm.collectionVariables.get('refund3Id_at'))) / 1000);",
                  "    console.log('refund3Id final: ' + last + ' after ~' + secs + ' s; history: ' + JSON.stringify(st));",
                  "    pm.test('refund3Id ends success', () => pm.expect(last).to.equal('success'));",
                  "} else if (n < Number(pm.collectionVariables.get('pollMax'))) {",
                  "    setTimeout(() => {}, Number(pm.collectionVariables.get('pollMs')));",
                  "    postman.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "    pm.collectionVariables.set('poll_refund3Id', 0);",
                  "    const secs = Math.round((Date.now() - Number(pm.collectionVariables.get('refund3Id_at'))) / 1000);",
                  "    console.log('refund3Id still ' + last + ' after ~' + secs + ' s; history: ' + JSON.stringify(st));",
                  "    pm.test('refund3Id reached a final status within the polling window (re-check later: timeout job runs after 15 min)', () => pm.expect.fail('still ' + last));",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    }
