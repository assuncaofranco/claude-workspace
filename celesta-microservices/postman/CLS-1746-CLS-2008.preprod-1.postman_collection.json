  "item": [
    {
      "name": "Backoffice",
      "item": [
        {
          "name": "1. BO Login (owner)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grant_type\": \"password\",\n  \"client_id\": \"{{BO_oauth_client_id}}\",\n  \"client_secret\": \"{{BO_oauth_client_secret}}\",\n  \"username\": \"{{BO_username}}\",\n  \"password\": \"{{BO_password}}\"\n}"
            },
            "url": {
              "raw": "{{BO_baseUrl}}/oauth/2.0/token",
              "host": [
                "{{BO_baseUrl}}"
              ],
              "path": [
                "oauth",
                "2.0",
                "token"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('BO_access_token', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Create bonus configuration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{BO_access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"CLS-1746-CLS-2008 custom attributes test\",\n  \"displayName\": \"Custom attributes test\",\n  \"type\": \"deposit\",\n  \"model\": \"direct\",\n  \"offeringMethod\": \"manual\",\n  \"currency\": \"EUR\",\n  \"validDuringDays\": 30,\n  \"claimingEvent\": \"deposit\",\n  \"claimingEventCondition\": {\"depositAmountMin\": 10, \"depositAmountMax\": 100},\n  \"offerPercent\": 100,\n  \"offerUpToAmount\": 100,\n  \"offerValidFor\": 14\n}"
            },
            "url": {
              "raw": "{{BO_baseUrl}}/api/gateway/domain/{{domainId}}/bonus_configuration",
              "host": [
                "{{BO_baseUrl}}"
              ],
              "path": [
                "api",
                "gateway",
                "domain",
                "{{domainId}}",
                "bonus_configuration"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('rewardConfigId', String(json.id));",
                  "pm.test('created disabled', () => pm.expect(json.status).to.eql('disabled'));"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Enable bonus configuration",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{BO_access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"enabled\"\n}"
            },
            "url": {
              "raw": "{{BO_baseUrl}}/api/gateway/domain/{{domainId}}/bonus_configuration/{{rewardConfigId}}",
              "host": [
                "{{BO_baseUrl}}"
              ],
              "path": [
                "api",
                "gateway",
                "domain",
                "{{domainId}}",
                "bonus_configuration",
                "{{rewardConfigId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('now enabled', () => pm.expect(pm.response.json().status).to.eql('enabled'));"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Create custom attribute configuration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{BO_access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{customAttributeName}}\",\n  \"type\": \"string\"\n}"
            },
            "url": {
              "raw": "{{BO_baseUrl}}/api/gateway/domain/{{domainId}}/reward_configuration/custom-attributes-configuration",
              "host": [
                "{{BO_baseUrl}}"
              ],
              "path": [
                "api",
                "gateway",
                "domain",
                "{{domainId}}",
                "reward_configuration",
                "custom-attributes-configuration"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const created = pm.response.code === 200;",
                  "const alreadyThere = pm.response.code === 400 && /already exists/i.test(pm.response.text());",
                  "pm.test('configuration is available (created now, or already present from an earlier run)', () => {",
                  "  pm.expect(created || alreadyThere, `unexpected ${pm.response.code}: ${pm.response.text()}`).to.be.true;",
                  "});",
                  "if (created) {",
                  "  pm.collectionVariables.set('customAttributeConfigId', String(pm.response.json().id));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "4b. Create custom attribute configuration with default (no value ever set)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{BO_access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{defaultAttributeName}}\",\n  \"type\": \"string\",\n  \"defaultValue\": \"{{defaultAttributeValue}}\"\n}"
            },
            "url": {
              "raw": "{{BO_baseUrl}}/api/gateway/domain/{{domainId}}/reward_configuration/custom-attributes-configuration",
              "host": [
                "{{BO_baseUrl}}"
              ],
              "path": [
                "api",
                "gateway",
                "domain",
                "{{domainId}}",
                "reward_configuration",
                "custom-attributes-configuration"
              ]
            }
