                  "if (pm.response.code >= 300) console.log(pm.request.method + ' ' + pm.request.url + ' -> ' + pm.response.code + ' ' + pm.response.text().slice(0, 600));",
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
