              },
              {
                "key": "Authorization",
                "value": "Bearer {{BO_access_token}}"
              }
            ],
            "url": "{{BO_baseUrl}}/api/gateway/domain/{{domainId}}/reward/bonus/{{bonusId}}/cancel",
            "body": {
