              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const created = pm.response.code === 200;",
                  "const alreadyThere = pm.response.code === 400 && /already exists/i.test(pm.response.text());",
                  "pm.test('configuration is available (created now, or already present from an earlier run)', () => {",
