            ],
            "url": {
              "raw": "{{baseUrl}}/reward/bonuses?customAttributes[]={{customAttributeName}}:silver",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reward",
                "bonuses"
              ],
              "query": [
                {
                  "key": "customAttributes[]",
                  "value": "{{customAttributeName}}:silver"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('no bonus matches an unmatched attribute value', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.bonus).to.be.an('array').that.is.empty;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
