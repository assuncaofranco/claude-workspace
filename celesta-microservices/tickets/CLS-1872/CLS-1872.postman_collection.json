                ]
              }
            }
          ]
        },
        {
          "name": "13. PUT without the booleans — both are named in one response",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
