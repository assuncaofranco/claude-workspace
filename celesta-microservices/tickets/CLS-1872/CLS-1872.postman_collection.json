              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{connectionNameRenamed}}\",\n  \"enabled\": null,\n  \"freeRoundsCancelable\": true,\n  \"options\": {\n    \"secret_key\": \"rotated-secret\",\n    \"bonus_api_base_url\": \"https://alea.example/bonus\",\n    \"customer_api_base_url\": \"https://alea.example/customer\",\n    \"environment_credential\": \"integration-credential\"\n  }\n}"
