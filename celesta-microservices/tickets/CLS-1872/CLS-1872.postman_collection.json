          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));",
                  "const e = pm.response.json();",
                  "pm.test('enabled is named', () => pm.expect(e).to.have.property('enabled'));",
                  "pm.test('freeRoundsCancelable is named too, not on a second attempt', () => pm.expect(e).to.have.property('freeRoundsCancelable'));"
                ]
              }
            }
          ]
        },
        {
          "name": "14. GET list — the three rejections changed nothing",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{BO_access_token}}"
              }
            ],
            "url": {
              "raw": "{{BO_baseUrl}}/api/gateway/domain/{{domainId}}/integration/game-providers",
              "host": [
                "{{BO_baseUrl}}/api/gateway/domain/{{domainId}}/integration/game-providers"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const c = pm.response.json().find(x => x.id === Number(pm.collectionVariables.get('connectionId')));",
                  "pm.test('still disabled from step 6', () => pm.expect(c.status).to.eql('disabled'));",
                  "pm.test('name untouched', () => pm.expect(c.name).to.eql(pm.collectionVariables.get('connectionNameRenamed')));",
                  "pm.test('empty options serialise as an object, never as []', () => {",
                  "    const anyEmpty = pm.response.text().includes('\"options\":[]');",
                  "    pm.expect(anyEmpty, 'found \"options\":[] in the payload').to.eql(false);",
                  "});"
                ]
              }
            }
          ]
