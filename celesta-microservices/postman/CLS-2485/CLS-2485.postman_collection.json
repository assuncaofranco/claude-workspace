        {
          "name": "POST bonus_configuration (free, manual)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{BO_access_token}}"
              }
            ],
            "url": "{{BO_baseUrl}}/api/gateway/domain/{{domainId}}/bonus_configuration",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{runTag}} free\",\n  \"displayName\": \"{{runTag}} free\",\n  \"type\": \"free\",\n  \"model\": \"wager\",\n  \"wageringMultiplier\": \"5.00\",\n  \"maxWinMultiplier\": \"10\",\n  \"offeringMethod\": \"manual\",\n  \"currency\": \"EUR\",\n  \"reason\": \"test\",\n  \"validDuringDays\": 3,\n  \"offerValidFor\": 2,\n  \"claimingEvent\": \"direct\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.environment.set('rcId', pm.response.json().id);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('runTag')) { const t = Date.now(); pm.environment.set('runTag', 'qa2485-' + t); pm.environment.set('roundId', String(Math.floor(t / 1000))); }"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH enable",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{BO_access_token}}"
              }
            ],
            "url": "{{BO_baseUrl}}/api/gateway/domain/{{domainId}}/bonus_configuration/{{rcId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"enabled\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('enabled', () => pm.expect(pm.response.json().status).to.eql('enabled'));"
                ]
              }
            }
          ]
        },
        {
          "name": "offer free bonus bonusR (10 EUR)",
          "request": {
            "method": "POST",
            "header": [
              {
