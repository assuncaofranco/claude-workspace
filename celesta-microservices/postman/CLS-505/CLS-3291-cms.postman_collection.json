    {
      "name": "4 BO custom email template",
      "item": [
        {
          "name": "POST custom-email-template",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{BO_access_token}}"
              }
            ],
            "url": "{{BO_baseUrl}}/api/gateway/domain/{{domainId}}/custom-email-template",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{runTag}} cet\",\n  \"enabled\": true,\n  \"translations\": {{cetTranslations}}\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('cetId', pm.response.json().id);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const langs = JSON.parse(pm.collectionVariables.get('langs') || '[\"en\"]');",
                  "const t = {}; langs.forEach(p => t[p] = {sender: 'no-reply@celesta.io', senderName: 'QA', subject: 'Hi {{player.first_name}}', content: '<p>' + pm.collectionVariables.get('runTag') + '</p>'});",
                  "pm.collectionVariables.set('cetTranslations', JSON.stringify(t));"
                ]
              }
