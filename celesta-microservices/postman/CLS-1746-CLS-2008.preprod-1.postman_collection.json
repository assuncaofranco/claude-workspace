            "url": {
              "raw": "{{baseUrl}}/reward/bonuses?customAttributes[]={{customAttributeName}}:{{customAttributeValue}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reward",
                "bonuses"
              ],
              "query": [
                {
                  "key": "customAttributes[]",
                  "value": "{{customAttributeName}}:{{customAttributeValue}}"
                }
