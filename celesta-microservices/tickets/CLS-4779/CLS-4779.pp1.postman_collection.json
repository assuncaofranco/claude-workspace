            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": \"{{partialAmount}}\",\n  \"refundType\": \"automatic\",\n  \"message\": \"CLS-4779 preprod check\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 300) console.log(pm.request.method + ' ' + pm.request.url + ' -> ' + pm.response.code + ' ' + pm.response.text().slice(0, 800));",
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "",
                  "const r = pm.response.json();",
                  "console.log('refund1Id answer at ' + new Date().toISOString() + ': ' + JSON.stringify(r).slice(0, 600));",
                  "pm.test('a refund transaction came back', () => {",
                  "    pm.expect(r.type).to.equal('refund');",
                  "    pm.expect(['initiated', 'pending', 'success']).to.include(r.status);",
                  "});",
                  "pm.collectionVariables.set('refund1Id', r.id);",
                  "pm.collectionVariables.set('refund1Id_at', Date.now());"
                ]
              }
            }
          ]
        },
        {
          "name": "Refund status until final ({{refund1Id}})",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{BO_access_token}}"
              }
            ],
            "url": "{{BO_baseUrl}}/api/gateway/domain/{{domainId}}/payment/player/{{playerId}}/transaction-history/{{refund1Id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 300) console.log(pm.request.method + ' ' + pm.request.url + ' -> ' + pm.response.code + ' ' + pm.response.text().slice(0, 800));",
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const st = (pm.response.json() || []).filter(h => h.type === 'status');",
                  "const last = st.length ? st[st.length - 1].valueAfter : null;",
                  "",
                  "const n = Number(pm.collectionVariables.get('poll_refund1Id') || 0) + 1;",
                  "pm.collectionVariables.set('poll_refund1Id', n);",
                  "if (['success', 'failure', 'timeout', 'fraud'].includes(last)) {",
                  "    pm.collectionVariables.set('poll_refund1Id', 0);",
                  "    const secs = Math.round((Date.now() - Number(pm.collectionVariables.get('refund1Id_at'))) / 1000);",
                  "    console.log('refund1Id final: ' + last + ' after ~' + secs + ' s; history: ' + JSON.stringify(st));",
                  "    pm.test('refund1Id ends success', () => pm.expect(last).to.equal('success'));",
                  "} else if (n < Number(pm.collectionVariables.get('pollMax'))) {",
                  "    setTimeout(() => {}, Number(pm.collectionVariables.get('pollMs')));",
                  "    postman.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "    pm.collectionVariables.set('poll_refund1Id', 0);",
                  "    const secs = Math.round((Date.now() - Number(pm.collectionVariables.get('refund1Id_at'))) / 1000);",
                  "    console.log('refund1Id still ' + last + ' after ~' + secs + ' s; history: ' + JSON.stringify(st));",
                  "    pm.test('refund1Id reached a final status within the polling window (re-check later: timeout job runs after 15 min)', () => pm.expect.fail('still ' + last));",
                  "}"
                ]
              }
            }
          ]
        },
