  {
   "name": "2 Compare per-player and domain routes",
   "event": [
    {
     "listen": "prerequest",
     "script": {
      "type": "text/javascript",
      "exec": [
       "const url = pm.variables.replaceIn(pm.request.url.toString());",
       "const m = url.match(/^https?:\\/\\/([^\\/:]+)(?::(\\d+))?([^?]*)/);",
       "if (m && ['88','99','89'].includes(m[2] || '')) {",
       "  const method = pm.request.method.toUpperCase();",
       "  let data = method + m[1] + decodeURIComponent(m[3]);",
       "  if (['POST','PUT','PATCH'].includes(method)) {",
       "    const body = (pm.request.body && pm.request.body.raw) ? pm.variables.replaceIn(pm.request.body.raw) : '';",
       "    data += CryptoJS.MD5(body).toString();",
       "  }",
       "  pm.request.headers.upsert({ key: 'x-guard-secret', value: CryptoJS.HmacSHA256(data, pm.environment.get('guardKey')).toString() });",
       "}"
      ]
     }
    }
   ],
   "item": [
    {
     "name": "Per-player route, player A, both transactions",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": "{{promotionUrl}}/api/domain/{{domainId}}/player/{{playerA}}/rewarding",
      "body": {
       "mode": "raw",
       "raw": "{\n  \"transactionIds\": [\n    \"{{txA}}\",\n    \"{{txB}}\"\n  ],\n  \"event\": \"deposit\"\n}"
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "if (pm.response.code !== 200) console.log(pm.request.method + ' ' + pm.request.url + ' -> ' + pm.response.code + ' ' + pm.response.text().slice(0, 400));",
         "pm.test('status 200', () => pm.response.to.have.status(200));",
         "const j = pm.response.json(); pm.environment.set('perA', JSON.stringify(j));",
         "pm.test('player A gets entries for its own deposit', () => pm.expect(j.length).to.be.above(0));",
         "pm.test('player A gets only its own deposit', () => j.forEach(e => pm.expect(e.transactionId).to.eql(Number(pm.environment.get('txA')))));"
        ]
       }
      }
     ]
    },
