        {
          "name": "9. List reward bonuses (customAttributes shows up)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reward/bonuses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reward",
                "bonuses"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('bonus has customAttributes with the set value', () => {",
                  "  const json = pm.response.json();",
                  "  const name = pm.collectionVariables.get('customAttributeName');",
                  "  const value = pm.collectionVariables.get('customAttributeValue');",
                  "  const bonus = json.bonus.find(b => String(b.id).startsWith(pm.collectionVariables.get('rewardConfigId') + '_'));",
                  "  pm.expect(bonus, 'bonus not found in list').to.exist;",
                  "  const found = (bonus.customAttributes || []).some(ca => ca.name === name && ca.value === value);",
                  "  pm.expect(found).to.be.true;",
                  "});",
                  "pm.test('bonus falls back to the configured default for an attribute with no explicit value', () => {",
                  "  const json = pm.response.json();",
                  "  const defaultName = pm.collectionVariables.get('defaultAttributeName');",
                  "  const defaultValue = pm.collectionVariables.get('defaultAttributeValue');",
                  "  const bonus = json.bonus.find(b => String(b.id).startsWith(pm.collectionVariables.get('rewardConfigId') + '_'));",
                  "  const attribute = (bonus.customAttributes || []).find(ca => ca.name === defaultName);",
                  "  pm.expect(attribute, 'default attribute not present in customAttributes').to.exist;",
                  "  pm.expect(attribute.value).to.eql(defaultValue);",
                  "  pm.expect(attribute.id).to.be.null;",
                  "  pm.expect(attribute.createdAt).to.be.null;",
                  "  pm.expect(attribute.updatedAt).to.be.null;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "10. Filter reward bonuses by custom attribute (matching)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
