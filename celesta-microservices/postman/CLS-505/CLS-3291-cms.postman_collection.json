{
  "info": {
    "name": "CLS-3291 cms Symfony 7.4",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 BO content tag",
      "item": [
        {
          "name": "BO token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{BO_baseUrl}}/oauth/2.0/token",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grant_type\": \"password\",\n  \"client_id\": \"{{BO_oauth_client_id}}\",\n  \"client_secret\": \"{{BO_oauth_client_secret}}\",\n  \"username\": \"{{BO_username}}\",\n  \"password\": \"{{BO_password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('BO_access_token', pm.response.json().access_token);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('runTag')) pm.collectionVariables.set('runTag', 'cls505-' + Date.now());"
                ]
              }
            }
          ]
        },
        {
          "name": "GET domain (languages)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{BO_access_token}}"
              }
            ],
            "url": "{{BO_baseUrl}}/api/gateway/domain/{{domainId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "const sec = d.secondaryLanguage ? (Array.isArray(d.secondaryLanguage) ? d.secondaryLanguage : [d.secondaryLanguage]) : [];",
                  "const langs = [...new Set([d.language || 'en', ...sec].filter(Boolean))];",
                  "pm.test('languages read', () => pm.expect(langs.length).to.be.above(0));",
                  "pm.collectionVariables.set('primaryLang', langs[0]);",
                  "pm.collectionVariables.set('langs', JSON.stringify(langs));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST content_tag",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{BO_access_token}}"
              }
            ],
            "url": "{{BO_baseUrl}}/api/gateway/domain/{{domainId}}/content_tag",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{runTag}} tag\",\n  \"backgroundColor\": \"#ff0000\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('tagId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST content_tags (list) -> contains tag",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{BO_access_token}}"
              }
            ],
            "url": "{{BO_baseUrl}}/api/gateway/domain/{{domainId}}/content_tags",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"limit\": 100,\n  \"offset\": 0\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json(); const list = j.data || j;",
                  "pm.test('tag listed', () => pm.expect(list.some(t => String(t.id) === String(pm.collectionVariables.get('tagId')))).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH content_tag",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{BO_access_token}}"
              }
            ],
            "url": "{{BO_baseUrl}}/api/gateway/domain/{{domainId}}/content_tag/{{tagId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{runTag}} tag2\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('renamed', () => pm.expect(pm.response.json().name).to.eql(pm.collectionVariables.get('runTag') + ' tag2'));"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH unknown tag -> 404",
          "request": {
            "method": "PATCH",
            "header": [
              {
