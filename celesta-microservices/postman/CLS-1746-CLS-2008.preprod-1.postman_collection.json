                  "pm.test('value was set', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.value).to.eql(pm.collectionVariables.get('customAttributeValue'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Get custom attributes (verify)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{BO_access_token}}"
              }
            ],
            "url": {
              "raw": "{{BO_baseUrl}}/api/gateway/domain/{{domainId}}/reward_configuration/{{rewardConfigId}}/custom-attributes",
              "host": [
                "{{BO_baseUrl}}"
              ],
              "path": [
                "api",
                "gateway",
                "domain",
                "{{domainId}}",
                "reward_configuration",
                "{{rewardConfigId}}",
                "custom-attributes"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('contains the set value', () => {",
                  "  const json = pm.response.json();",
                  "  const name = pm.collectionVariables.get('customAttributeName');",
                  "  const value = pm.collectionVariables.get('customAttributeValue');",
                  "  const found = json.some(ca => ca.name === name && ca.value === value);",
                  "  pm.expect(found).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
