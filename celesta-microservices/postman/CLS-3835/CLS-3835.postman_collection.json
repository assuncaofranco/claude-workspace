{
  "info": {
    "name": "CLS-3835 gateway default bonus list page size 50",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0 Baseline: how many bonuses the player has",
      "item": [
        {
          "name": "Player token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/oauth/2.0/token",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grant_type\": \"player\",\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"client_id\": \"{{oauth_client_id}}\",\n  \"client_secret\": \"{{oauth_client_secret}}\",\n  \"deviceInformation\": {\n    \"ip\": \"127.0.0.1\",\n    \"userAgent\": \"Mozilla/5.0\"\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const t = pm.response.json().access_token;",
                  "pm.collectionVariables.set('access_token', t);",
                  "const b64 = t.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');",
                  "const claims = JSON.parse(CryptoJS.enc.Base64.parse(b64).toString(CryptoJS.enc.Utf8));",
                  "pm.collectionVariables.set('playerId', String(claims.sub));",
                  "pm.collectionVariables.set('domainId', String(claims.domain_id));",
                  "pm.collectionVariables.set('currency', claims.customer.currency);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /bonuses?limit=1000",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{baseUrl}}/bonuses?limit=1000"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const ids = pm.response.json().bonus.map(b => String(b.id));",
                  "pm.collectionVariables.set('toOffer', String(Math.max(0, Number(pm.variables.get('minBonuses')) - ids.length)));",
                  "console.log('player has ' + ids.length + ' bonuses, offering ' + pm.collectionVariables.get('toOffer'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1 BO setup: top the player up to minBonuses (skipped when already there)",
      "item": [
        {
          "name": "BO token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{BO_baseUrl}}/oauth/2.0/token",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grant_type\": \"password\",\n  \"client_id\": \"{{BO_oauth_client_id}}\",\n  \"client_secret\": \"{{BO_oauth_client_secret}}\",\n  \"username\": \"{{BO_username}}\",\n  \"password\": \"{{BO_password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('BO_access_token', pm.response.json().access_token);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (Number(pm.collectionVariables.get('toOffer')) <= 0) pm.execution.skipRequest();"
                ]
              }
            }
          ]
        },
        {
          "name": "POST bonus_configuration (free, manual)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{BO_access_token}}"
              }
            ],
            "url": "{{BO_baseUrl}}/api/gateway/domain/{{domainId}}/bonus_configuration",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"qa3835-{{$timestamp}}\",\n  \"displayName\": \"qa3835\",\n  \"type\": \"free\",\n  \"model\": \"wager\",\n  \"wageringMultiplier\": \"5.00\",\n  \"maxWinMultiplier\": \"10\",\n  \"offeringMethod\": \"manual\",\n  \"currency\": \"{{currency}}\",\n  \"reason\": \"test\",\n  \"validDuringDays\": 3,\n  \"offerValidFor\": 2,\n  \"claimingEvent\": \"direct\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('rcId', pm.response.json().id);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (Number(pm.collectionVariables.get('toOffer')) <= 0) pm.execution.skipRequest();"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH enable",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{BO_access_token}}"
              }
            ],
            "url": "{{BO_baseUrl}}/api/gateway/domain/{{domainId}}/bonus_configuration/{{rcId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"enabled\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('enabled', () => pm.expect(pm.response.json().status).to.eql('enabled'));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (Number(pm.collectionVariables.get('toOffer')) <= 0) pm.execution.skipRequest();"
                ]
              }
            }
          ]
        },
        {
          "name": "POST offer (loops until toOffer is 0)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{BO_access_token}}"
              }
            ],
            "url": "{{BO_baseUrl}}/api/gateway/domain/{{domainId}}/player/{{playerId}}/bonus_configuration/{{rcId}}/offer",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"playerId\": \"{{playerId}}\",\n  \"amount\": 1,\n  \"message\": \"QA CLS-3835\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('offered', () => pm.expect(pm.response.json().status).to.eql('offered'));",
                  "const left = Number(pm.collectionVariables.get('toOffer')) - 1;",
                  "pm.collectionVariables.set('toOffer', String(left));",
                  "if (left > 0) pm.execution.setNextRequest(pm.info.requestName);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (Number(pm.collectionVariables.get('toOffer')) <= 0) pm.execution.skipRequest();"
                ]
              }
            }
          ]
        }
      ]
    },
