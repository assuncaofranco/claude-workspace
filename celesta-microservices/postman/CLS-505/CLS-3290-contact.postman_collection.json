{
  "info": {
    "name": "CLS-3290 contact Symfony 7.4",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 BO email providers (read only)",
      "item": [
        {
          "name": "BO token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{BO_baseUrl}}/oauth/2.0/token",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grant_type\": \"password\",\n  \"client_id\": \"{{BO_oauth_client_id}}\",\n  \"client_secret\": \"{{BO_oauth_client_secret}}\",\n  \"username\": \"{{BO_username}}\",\n  \"password\": \"{{BO_password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('BO_access_token', pm.response.json().access_token);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('runTag')) pm.collectionVariables.set('runTag', 'cls505-' + Date.now());"
                ]
              }
            }
          ]
        },
        {
          "name": "GET email_providers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{BO_access_token}}"
              }
            ],
            "url": "{{BO_baseUrl}}/api/gateway/domain/{{domainId}}/email_providers"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('is a list', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT unknown provider -> 404 (entity resolution, no write)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{BO_access_token}}"
              }
            ],
            "url": "{{BO_baseUrl}}/api/gateway/domain/{{domainId}}/email_provider/999999999",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enabled\": false,\n  \"type\": \"sendgrid\",\n  \"apiKey\": \"SG.cls505\",\n  \"apiKeyId\": \"cls505\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 GW forgot password -> contact /emails",
      "item": [
        {
          "name": "Player token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/oauth/2.0/token",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grant_type\": \"player\",\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"client_id\": \"{{oauth_client_id}}\",\n  \"client_secret\": \"{{oauth_client_secret}}\",\n  \"deviceInformation\": {\n    \"ip\": \"127.0.0.1\",\n    \"userAgent\": \"Mozilla/5.0\"\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('access_token', pm.response.json().access_token);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('runTag')) pm.collectionVariables.set('runTag', 'cls505-' + Date.now());"
                ]
              }
            }
          ]
        },
        {
          "name": "POST forgot-password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{baseUrl}}/forgot-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{username}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "BO_baseUrl",
      "value": "http://localhost:84"
    },
    {
      "key": "baseUrl",
      "value": "http://localhost:93"
    },
    {
      "key": "domainId",
      "value": "1"
    },
    {
      "key": "runTag",
      "value": ""
    },
    {
      "key": "BO_access_token",
      "value": ""
    },
    {
      "key": "access_token",
      "value": ""
    }
  ]
}