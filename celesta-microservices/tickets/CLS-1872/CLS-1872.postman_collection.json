            "url": {
              "raw": "{{BO_baseUrl}}/api/gateway/domain/{{domainId}}/integration/game-providers",
              "host": [
                "{{BO_baseUrl}}/api/gateway/domain/{{domainId}}/integration/game-providers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"gateway_type_aleaplay\",\n  \"name\": \"{{connectionNameRenamed}}\",\n  \"enabled\": true,\n  \"freeRoundsCancelable\": true,\n  \"options\": {\n    \"secret_key\": \"rotated-secret\",\n    \"bonus_api_base_url\": \"https://alea.example/bonus\",\n    \"customer_api_base_url\": \"https://alea.example/customer\",\n    \"environment_credential\": \"integration-credential\"\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400, not 500', () => pm.response.to.have.status(400));",
                  "const e = pm.response.json();",
                  "pm.test('the error is on the name field', () => pm.expect(e).to.have.property('name'));",
                  "pm.test('no raw SQL reaches the operator', () => pm.expect(pm.response.text()).to.not.include('SQLSTATE'));"
                ]
              }
            }
          ]
        },
        {
          "name": "12. PUT with enabled null — rejected, and the connection stays enabled",
          "request": {
            "method": "PUT",
