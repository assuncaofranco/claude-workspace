        {
          "name": "GET bonuses: R and C played",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{BO_access_token}}"
              }
            ],
            "url": "{{BO_baseUrl}}/api/gateway/domain/{{domainId}}/bonuses?filter[ownerIds][]={{playerId}}&filter[bonusModelIds][]={{rcId}}&filter[statuses][]=offered&filter[statuses][]=claimed&filter[statuses][]=played&filter[statuses][]=canceled&limit=50"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "const st = v => (list.find(x => String(x.id) === String(pm.environment.get(v))) || {}).status;",
                  "pm.test('bonusR is played', () => pm.expect(st('bonusR')).to.eql('played'));",
                  "pm.test('bonusC is played', () => pm.expect(st('bonusC')).to.eql('played'));"
                ]
              }
            }
          ]
        }
      ]
