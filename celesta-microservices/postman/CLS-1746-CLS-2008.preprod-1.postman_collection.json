            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('returns the matching bonus', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.bonus).to.be.an('array').that.is.not.empty;",
                  "  const found = json.bonus.some(b => String(b.id).startsWith(pm.collectionVariables.get('rewardConfigId') + '_'));",
                  "  pm.expect(found).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "11. Filter reward bonuses by custom attribute (no match)",
