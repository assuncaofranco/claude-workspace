{
  "info": {
    "name": "CLS-4779 pp1: Paytech card automatic refund",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 Player: Paytech card deposit",
      "item": [
        {
          "name": "Player token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/oauth/2.0/token",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grant_type\": \"player\",\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"client_id\": \"{{oauth_client_id}}\",\n  \"client_secret\": \"{{oauth_client_secret}}\",\n  \"deviceInformation\": {\n    \"ip\": \"127.0.0.1\",\n    \"userAgent\": \"Mozilla/5.0\"\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 300) console.log(pm.request.method + ' ' + pm.request.url + ' -> ' + pm.response.code + ' ' + pm.response.text().slice(0, 800));",
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('access_token', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Player balance (before)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{baseUrl}}/wallet/balances"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 300) console.log(pm.request.method + ' ' + pm.request.url + ' -> ' + pm.response.code + ' ' + pm.response.text().slice(0, 800));",
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "",
                  "const eur = (pm.response.json().balances || []).find(b => b.currency === 'EUR') || {};",
                  "console.log('balance before: ' + JSON.stringify(eur));",
                  "pm.collectionVariables.set('balanceBefore', JSON.stringify(eur));"
                ]
              }
            }
          ]
        },
        {
          "name": "Paytech card deposit ({{depositAmount}} EUR)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{baseUrl}}/payment",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentInformation\": {\n    \"paymentConfigurationId\": \"{{paytechVisaConfigurationId}}\",\n    \"holder\": \"{{cardHolder}}\",\n    \"number\": \"{{cardNumber}}\",\n    \"expirationDate\": {\n      \"month\": \"{{cardMonth}}\",\n      \"year\": \"{{cardYear}}\"\n    },\n    \"cvv\": \"{{cardCvv}}\",\n    \"reusable\": false\n  },\n  \"amount\": \"{{depositAmount}}\",\n  \"ip\": \"138.199.14.138\",\n  \"userAgent\": \"Mozilla/5.0\",\n  \"successUrl\": \"https://example.com/callback/success\",\n  \"failureUrl\": \"https://example.com/callback/failure\",\n  \"additionalData\": {\n    \"seonSession\": \"{{seonSession}}\",\n    \"browserAcceptHeader\": \"text/html\",\n    \"browserJavaEnabled\": true,\n    \"browserLanguage\": \"en\",\n    \"browserColorDepth\": \"24\",\n    \"browserScreenHeight\": \"1200\",\n    \"browserScreenWidth\": \"1920\",\n    \"browserTimezone\": \"0\"\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 300) console.log(pm.request.method + ' ' + pm.request.url + ' -> ' + pm.response.code + ' ' + pm.response.text().slice(0, 800));",
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "",
                  "const b = pm.response.json();",
                  "console.log('deposit: ' + JSON.stringify(b).slice(0, 600));",
                  "pm.test('deposit accepted by Paytech (no 3DS redirect, no error)', () => {",
                  "    pm.expect(b.redirectionHtml || null, 'a 3DS redirect came back: use a card not enrolled for 3DS').to.equal(null);",
                  "    pm.expect(['success', 'pending']).to.include(b.status);",
                  "});",
                  "pm.collectionVariables.set('depositUid', b.id);"
                ]
              }
            }
          ]
        }
      ]
