     "name": "BO token",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": "{{BO_baseUrl}}/oauth/2.0/token",
      "body": {
       "mode": "raw",
       "raw": "{\n  \"grant_type\": \"password\",\n  \"client_id\": \"{{BO_oauth_client_id}}\",\n  \"client_secret\": \"{{BO_oauth_client_secret}}\",\n  \"username\": \"{{BO_username}}\",\n  \"password\": \"{{BO_password}}\"\n}"
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "if (pm.response.code !== 200) console.log(pm.request.method + ' ' + pm.request.url + ' -> ' + pm.response.code + ' ' + pm.response.text().slice(0, 400));",
         "pm.test('status 200', () => pm.response.to.have.status(200));",
         "pm.environment.set('BO_access_token', pm.response.json().access_token);"
        ]
       }
      },
      {
       "listen": "prerequest",
       "script": {
        "type": "text/javascript",
        "exec": [
         "if (!pm.environment.get('runTag')) {",
         "  const t = Date.now(); pm.environment.set('runTag', 'qa4314-' + t);",
         "  const d = n => new Date(t + n*86400000).toISOString().slice(0,10);",
         "  pm.environment.set('startDate', d(-1) + ' 00:00:00'); pm.environment.set('endDate', d(30) + ' 23:59:59');",
         "}"
        ]
       }
      }
