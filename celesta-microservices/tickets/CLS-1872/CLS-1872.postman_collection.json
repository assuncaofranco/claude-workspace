                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const items = pm.response.json();",
                  "pm.test('no connection named by the refused calls', () => pm.expect(items.some(i => i.name === 'Should not be created')).to.be.false);",
                  "const id = Number(pm.collectionVariables.get('connectionId'));",
                  "const c = items.find(i => i.id === id);",
                  "pm.test('name still the one owner set', () => pm.expect(c.name).to.eql(pm.collectionVariables.get('connectionNameRenamed')));"
                ]
              }
            }
          ]
