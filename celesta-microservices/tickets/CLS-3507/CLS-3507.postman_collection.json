              "mode": "raw",
              "raw": "{\n  \"value\": \"120\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('value is 120 (JSON number or null)', () => { pm.expect(b.value).to.eql(120); pm.expect(typeof b.value).to.eql(\"number\"); });",
                  "pm.test('type numerical', () => pm.expect(b.type).to.eql('numerical'));"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH 2.4",
